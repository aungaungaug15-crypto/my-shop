<%- include('partials/header') %>
<div style="max-width: 800px; margin: 30px auto; padding: 20px;">
  <h2 style="color: #1e293b; margin-bottom: 20px; text-align: center;">🚀 ဝန်ဆောင်မှု (Service) တစ်ခုကို ရွေးချယ်ပါ</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
    <% services.forEach(s => { %>
      <a href="/service/<%= s.id %>" style="background: white; padding: 25px; border-radius: 12px; text-decoration: none; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); text-align: center; transition: transform 0.2s; display: block;">
        <div style="font-size: 3rem; margin-bottom: 10px;"><%= s.icon %></div>
        <h3 style="color: #0f172a; margin: 10px 0;"><%= s.name %></h3>
        <p style="color: #64748b; font-size: 0.85rem; margin: 0;"><%= s.desc %></p>
      </a>
    <% }) %>
  </div>
</div>
<%- include('partials/footer') %>
