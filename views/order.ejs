<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TERMINAL // <%= order.serviceName %></title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Share Tech Mono', monospace;
            background-color: #05050a;
            background-image: 
                linear-gradient(rgba(0, 255, 204, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 204, 0.03) 1px, transparent 1px);
            background-size: 20px 20px;
            color: #00ffcc;
            min-height: 100vh;
        }
        .cyber-nav {
            background: rgba(10, 10, 26, 0.9);
            border-bottom: 2px solid #00ffcc;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.2);
        }
        .cyber-card {
            background: rgba(10, 10, 26, 0.85);
            border: 2px solid #00ffcc;
            border-radius: 4px;
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.3);
        }
        .phone-display {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc;
            letter-spacing: 2px;
        }
        .btn-cyber-copy {
            background: #00ffcc;
            border: none;
            color: #05050a;
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 10px 24px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
        }
        .btn-cyber-copy:hover {
            background: #ff007f;
            color: #fff;
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.8);
        }
        .sms-box {
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid #00ffcc;
            border-radius: 2px;
        }
        .otp-badge {
            background: rgba(255, 0, 127, 0.2);
            color: #ff007f;
            border: 1px solid #ff007f;
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            letter-spacing: 2px;
            padding: 6px 14px;
            border-radius: 2px;
            text-shadow: 0 0 5px #ff007f;
        }
        .cyber-title {
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            color: #fff;
            text-shadow: 0 0 10px #00ffcc;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>
    <nav class="navbar cyber-nav px-4 py-3 mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="javascript:history.back()" class="btn btn-outline-info btn-sm rounded-0 px-3" style="font-family: 'Orbitron'; font-size: 0.75rem;"><i class="fas fa-arrow-left me-1"></i> BACK</a>
            <span class="cyber-title fs-6"><%= order.countryFlag %> <%= order.serviceName %></span>
            <span class="badge bg-success bg-opacity-20 text-success border border-success px-3 py-2 rounded-0 small" style="font-family: 'Orbitron';">
                <i class="fas fa-circle text-success me-1" style="font-size: 6px;"></i> STREAM_LIVE
            </span>
        </div>
    </nav>
    <div class="container" style="max-width: 620px; margin-top: 20px;">
        <div class="cyber-card p-4 p-md-5 mb-5 text-center">
            <p class="text-secondary text-uppercase small fw-bold mb-1">> TARGET_STREAM_ID</p>
            <div class="phone-display mb-3" id="phoneNumberText"><%= order.phone %></div>
            <div class="mb-4">
                <button onclick="copyPhoneNumber()" class="btn btn-cyber-copy d-inline-flex align-items-center gap-2">
                    <i class="fas fa-copy" id="copyIcon"></i>
                    <span id="copyBtnText">COPY NUMBER</span>
                </button>
            </div>
            <hr class="border-secondary opacity-50 my-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="cyber-title m-0 text-start fs-6"><i class="fas fa-satellite-dish text-info me-2"></i> INCOMING_SMS_STREAM</h6>
                <span class="text-secondary small">> LISTENING...</span>
            </div>
            <div class="d-flex flex-column gap-3 text-start">
                <% if (order.messages && order.messages.length > 0) { %>
                    <% order.messages.forEach(msg => { %>
                        <div class="sms-box p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-info small" style="font-family: 'Orbitron';"><%= msg.sender %></span>
                                <span class="text-secondary" style="font-size: 0.75rem;"><%= msg.time %></span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between bg-black p-2 rounded-0 border border-secondary mb-2">
                                <span class="text-secondary small">OTP_CODE:</span>
                                <span class="otp-badge"><%= msg.code %></span>
                            </div>
                            <p class="m-0 text-light opacity-75" style="font-size: 0.88rem; word-break: break-all;"><%= msg.text %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-4 text-secondary">
                        <i class="fas fa-satellite fa-2x mb-2 opacity-50"></i>
                        <p class="m-0 small">> WAITING_FOR_PACKETS...</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <script>
        function copyPhoneNumber() {
            const phoneText = document.getElementById('phoneNumberText').innerText.trim();
            navigator.clipboard.writeText(phoneText).then(() => {
                const btnText = document.getElementById('copyBtnText');
                const copyIcon = document.getElementById('copyIcon');
                btnText.innerText = 'COPIED! ✓';
                copyIcon.classList.remove('fa-copy');
                copyIcon.classList.add('fa-check');
                setTimeout(() => {
                    btnText.innerText = 'COPY NUMBER';
                    copyIcon.classList.remove('fa-check');
                    copyIcon.classList.add('fa-copy');
                }, 2000);
            }).catch(err => { alert('FAILED_TO_COPY!'); });
        }
        setInterval(() => {
            fetch('/api/sync-sms/<%= order.id %>')
                .then(res => res.json())
                .then(data => { if (data.updated) { location.reload(); } })
                .catch(e => console.log(e));
        }, 5000);
    </script>
</body>
</html>
