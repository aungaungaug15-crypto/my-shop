<%- include('partials/header') %>

<div style="margin-bottom: 20px;">
  <a href="/product/<%= service.id %>" style="text-decoration: none; color: #2563eb; font-weight: bold;">← နိုင်ငံရွေးချယ်မှုသို့ ပြန်သွားမည်</a>
</div>

<div style="background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); margin-bottom: 25px; text-align: center;">
  <div style="font-size: 2.5rem;"><%= country.flag %> <%= service.icon %></div>
  <h2 style="margin-top: 10px;"><%= service.name %> (<%= country.name %>)</h2>
  <p style="color: #64748b; margin-top: 5px;">အသုံးပြုလိုသော ဖုန်းနံပါတ်တစ်ခုကို အောက်ပါထဲမှ ရွေးချယ်ပါ</p>
</div>

<h3 style="margin-bottom: 15px;">📞 ရရှိနိုင်သော ဖုန်းနံပါတ် (၄) ခု:</h3>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 15px;">
  <% numbers.forEach((num, index) => { %>
    <div style="background: white; padding: 20px; border-radius: 12px; border: 2px solid #e2e8f0; text-align: center;">
      <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 5px;">Option #<%= index + 1 %></p>
      <h3 style="color: #2563eb; font-size: 1.3rem; margin-bottom: 15px;"><%= num %></h3>
      <form action="/confirm-number" method="POST">
        <input type="hidden" name="serviceId" value="<%= service.id %>" />
        <input type="hidden" name="countryId" value="<%= country.id %>" />
        <input type="hidden" name="selectedPhone" value="<%= num %>" />
        <button type="submit" style="width: 100%; background: #10b981; color: white; padding: 10px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">
          ဒီနံပါတ်ကို ယူမည်
        </button>
      </form>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
